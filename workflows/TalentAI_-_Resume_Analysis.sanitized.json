    {
      "parameters": {
        "jsCode": "\nconst resultado = $input.first().json.output;\n\n// Convertir el texto JSON de la IA en un objeto JavaScript\nconst evaluacion = JSON.parse(resultado);\n\n// Devolver cada campo por separado\nreturn [\n  {\n    json: {\n      fecha_evaluacion: new Date().toISOString(),\n      nombre_candidato: evaluacion.nombre_candidato,\n      correo_candidato: evaluacion.correo_candidato,\n      cargo: evaluacion.cargo,\n      compatibilidad: evaluacion.compatibilidad,\n      resumen: evaluacion.resumen,\n      fortalezas: evaluacion.fortalezas,\n      brechas: evaluacion.brechas,\n      recomendacion: evaluacion.recomendacion,\n      informe_completo: evaluacion.informe_completo,\n      estado: \"Evaluado\"\n    }\n  }\n];\n"
      },
